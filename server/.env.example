# Copy this file to ".env" (same folder) and fill in your details.
# NEVER upload .env to GitHub — it is already in .gitignore.

PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Gmail account that SENDS the emails
GMAIL_USER=contact.iot.automation@gmail.com
# 16-letter App Password from https://myaccount.google.com/apppasswords (spaces are OK)
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Inbox that RECEIVES the enquiries
RECEIVER_EMAIL=contact.iot.automation@gmail.com
